# CALL-E adapter selection.
# "fake" is the default for development, automated tests and public exploration.
# "live" places real calls and must be enabled explicitly.
CALLE_MODE=fake

# Required only when CALLE_MODE=live.
# API key from dashboard.heycall-e.com/account/api-keys — NOT the same
# credential as `calle auth login`'s browser OAuth session, which is a
# separate, Claude-Code-only development tool (see README).
CALLE_API_KEY=
CALLE_BASE_URL=https://api.heycall-e.com

# Public HTTPS URL of this app's /api/webhooks/calle route (e.g. your Vercel
# deployment). Leave unset for local dev — CALL-E requires HTTPS, so plain
# http://localhost cannot receive webhooks; use the poll route instead.
CALLE_WEBHOOK_URL=

# Shared secret used to verify the CALL-E-Signature header on inbound
# webhooks. Provisioning is not yet confirmed — see docs/DECISION_LOG.md.
CALLE_WEBHOOK_SECRET=

# E.164 numbers of the consenting test participants KinCall dials in live
# mode (e.g. +33612345678) — the vulnerable person, then each trusted contact
# in cascade order. Required only when CALLE_MODE=live.
#
# Leaving one unset keeps a reserved-for-fiction default (+336399800xx) that
# KinCall refuses to dial: the event goes to HUMAN_REVIEW_REQUIRED naming the
# missing variable, and no CALL-E request is made. Every number here belongs
# to someone who agreed to be called. Never commit a real number.
KINCALL_DEMO_PHONE=
KINCALL_JULIE_PHONE=
KINCALL_MARC_PHONE=
KINCALL_NICOLE_PHONE=

# ── Persistence ─────────────────────────────────────────────────────────────
# "memory" (default) keeps everything in-process: zero configuration, zero
# network, and exactly the behaviour KinCall had before Supabase was wired up.
# Data is lost on every restart, so an event mid-cascade is orphaned.
# "supabase" persists across restarts, redeploys and Vercel instances.
#
# Rolling back is this variable, not a code change: set it to "memory" and
# redeploy. The schema is left untouched.
KINCALL_PERSISTENCE=memory

# Required only when KINCALL_PERSISTENCE=supabase.
# Deliberately NOT prefixed NEXT_PUBLIC_: those are inlined into the browser
# bundle, and the service-role key bypasses Row Level Security. Both variables
# are server-only and must never reach client code.
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# How long one worker may hold a call result before another may reclaim it.
# Rule of thumb: set this at or above your platform's function timeout
# (Vercel's maxDuration), so a worker that is still running is never preempted
# while a killed worker's lease expires shortly after its death. Too short
# wastes work on concurrent replays (safe — every write is idempotent); too
# long delays recovery from a crash.
KINCALL_PROCESSING_LEASE_SECONDS=90

# ── Supabase integration tests (npm run test:integration) ───────────────────
# All four are required, or the lane fails loudly rather than skipping — a
# half-configured run must not look green. The anon key is not optional: the
# security assertions make real unprivileged calls, because introspecting
# privileges alone would not prove PostgREST rejects them.
#
# Point these at a DISPOSABLE project, or a local `supabase start`. The suite
# truncates every event table. It also requires kincall_test_reset(), which
# ships only in supabase/testing/9999_test_helpers.sql and must never be
# applied to production — that absence is what makes the suite structurally
# incapable of running against production.
KINCALL_TEST_SUPABASE_URL=
KINCALL_TEST_SUPABASE_SERVICE_ROLE_KEY=
KINCALL_TEST_SUPABASE_ANON_KEY=
KINCALL_TEST_SUPABASE_ALLOW_DESTRUCTIVE=

# Optional extra guard: comma-separated URLs the test lane must never target.
KINCALL_PRODUCTION_SUPABASE_URLS=
